# Copy to apps/mobile/.env.local (git-ignored) and fill in. Expo loads it for `expo start`,
# `expo run:ios` and app.config.ts. EXPO_PUBLIC_* values are bundled into the app (not secrets).

# Post It Up server URL. Simulator/web: http://localhost:8787; physical phone: your Mac's LAN IP, e.g. http://192.168.1.20:8787.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Google sign-in iOS OAuth client ID: Google Cloud → Google Auth Platform → Clients → iOS (with APP_BUNDLE_ID below).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# Optional fallback Spotify client ID; normally the app gets it from the server's GET /config.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# iOS bundle ID / Android package used by app.config.ts (falls back to com.example.postitup with a warning).
APP_BUNDLE_ID=com.example.postitup
