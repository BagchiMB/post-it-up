# Copy to apps/server/.env (git-ignored) and fill in. Placeholders only — never commit real values.
# "Seed only" = stored in the DB on first boot, then managed on the admin pages (/admin); later env
# changes are ignored for those.

# Port to listen on.
PORT=8787
# Interface to bind; 0.0.0.0 lets a phone on the same Wi-Fi reach the server (use 127.0.0.1 behind a proxy).
HOST=0.0.0.0

# SQLite DB, master key and job thumbnails (relative paths are relative to apps/server/).
DATA_DIR=./data

# 32-byte key (64 hex chars or base64) encrypting Spotify tokens and stored keys; empty = generate data/master.key on first boot.
MASTER_KEY=

# Google OAuth client ID(s) whose ID tokens are accepted, comma-separated (the app's iOS client ID).
GOOGLE_CLIENT_IDS=1234567890-abc123.apps.googleusercontent.com

# 1 enables POST /auth/dev (email-only sign-in) for local testing. NEVER enable on a public server.
DEV_LOGIN=0

# Admin account username (seed only; afterwards managed at /admin/account).
ADMIN_USERNAME=admin
# Admin account password, 12+ characters — replace this placeholder before first boot (seed only; later /admin/account).
ADMIN_PASSWORD=change-me-to-a-long-password
# 1 for ONE boot re-seeds the admin account from the two values above (e.g. forgotten password); then remove it.
ADMIN_RESET=

# Server-wide OpenRouter API key from openrouter.ai/keys, e.g. sk-or-v1-… (seed only; then /admin/integrations).
# Left empty here on purpose: a placeholder would be stored as the key on first boot. Never logged.
OPENROUTER_API_KEY=
# Default AI model id (seed only; then /admin AI settings).
OPENROUTER_DEFAULT_MODEL=openai/gpt-6-astra
# Max POST /jobs + retries per user per UTC day (seed only; then /admin limits).
DAILY_JOB_LIMIT=20

# Spotify app client ID from developer.spotify.com/dashboard, 32 hex chars (seed only; then /admin/integrations).
# Served to the app via GET /config. Empty here so no placeholder gets stored.
SPOTIFY_CLIENT_ID=
# Spotify app client secret (seed only; stored encrypted; then /admin/integrations). Server-only, never logged.
SPOTIFY_CLIENT_SECRET=

# ntfy server for "your post is ready" pushes.
NTFY_URL=https://ntfy.sh

# 1 when behind a reverse proxy (Caddy/nginx) so X-Forwarded-For is used for rate limiting and Secure cookies.
TRUST_PROXY=0

# Your app's iOS bundle ID (same as apps/mobile APP_BUNDLE_ID); only shown in the admin Spotify note.
APP_BUNDLE_ID=com.example.postitup
